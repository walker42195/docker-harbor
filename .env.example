PORT=6969
JWT_SECRET=docker-harbor-super-secret-jwt-key-2026-novabase
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# --- Multi-server ---
# Lösenord för att låsa upp skrivåtgärder mot skrivskyddade servrar i UI:t.
# Lämnas det tomt genereras ett slumpat lösenord vid start och skrivs till
# containerloggen en gång.
WRITE_UNLOCK_PASSWORD=

# Image som installationsskriptet ber fjärrservrarna hämta.
HARBOR_AGENT_IMAGE=docker-harbor-agent:latest

# wss://-adressen agenterna ska ansluta till. Lämnas den tom härleds den från
# inkommande request (fungerar bakom Cloudflare/reverse proxy).
HARBOR_HUB_WS_URL=

# Hur ofta varje server rapporterar containers och host-metrics (ms).
SNAPSHOT_INTERVAL_MS=5000

# Låt en container på en ny server ärva infotexten från en lokal container med
# samma namn. Av som standard för att undvika felmärkningar.
DESCRIPTIONS_CROSS_SERVER_FALLBACK=false
